---
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader";
import SiteHeader from "../components/SiteHeader.astro";
import Maxi from "../components/Maxi.astro";
import { profileLinks } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === "Vee" ? "Vee — Systems, communities, and builder experience" : `${title} — Vee`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("vee-theme");
          const theme = savedTheme === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            theme === "dark" ? "#0d0d0c" : "#f4f1e8",
          );
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <p class="site-footer__signoff">Built with care, and still becoming.</p>
        <p class="site-footer__meta">Vee · Hyderabad / Bengaluru · 2026</p>
      </div>
      <nav class="footer-links" aria-label="Social links">
        {profileLinks.map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
            {link.label}
            {link.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </nav>
    </footer>
    <Maxi />
  </body>
</html>
