---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SoundToggle from "../components/SoundToggle.astro";
import { profileLinks, site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** For pages that are reachable but deliberately not surfaced yet. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title === site.name ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fcfcfc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="ground" aria-hidden="true"></div>
    <div class="rainbow-layer" data-rainbow-layer aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer column">
      <div>
        <p class="meta">{site.location} · {year}</p>
        <p class="lede" style="margin-top: 0.4rem; font-size: 0.92rem;">Say hello — I read everything.</p>
      </div>
      <div class="site-footer__end">
        <nav class="footer-links" aria-label="Elsewhere">
        {profileLinks.map((link) => (
          <a
            href={link.href}
            data-sfx="nav"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {link.label}
            {link.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
        </nav>
        <SoundToggle />
      </div>
    </footer>
  </body>
</html>
