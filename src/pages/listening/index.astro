---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { spotify } from "../../data/site";
---

<BaseLayout title="Listening" description="What Vee has been listening to lately.">
  <header class="page-head column">
    <h1>Listening</h1>
    <p>A small, current corner of the internet for what has been in rotation lately.</p>
  </header>

  <section class="section column listening" aria-labelledby="listening-rotation">
    <div class="listening__head">
      <p class="meta">Spotify playlist</p>
      <h2 id="listening-rotation">On repeat</h2>
      <p>What I am reaching for right now — revised whenever the mood changes.</p>
    </div>

    <iframe
      class="listening__embed"
      src={spotify.embedUrl}
      title={spotify.title}
      loading="lazy"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    ></iframe>

    <p class="listening__fallback">
      Spotify not loading? <a href={spotify.playlistUrl} target="_blank" rel="noreferrer">Open the playlist<span class="sr-only"> (opens in a new tab)</span></a>.
    </p>
  </section>
</BaseLayout>

<style>
  .listening__head {
    margin-bottom: 1.5rem;
  }

  .listening__head .meta,
  .listening__head p {
    margin: 0;
  }

  .listening__head h2 {
    margin: 0.35rem 0 0.45rem;
    font-family: var(--display);
    font-size: clamp(1.5rem, 4vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .listening__head > p:last-child {
    max-width: 43ch;
    color: var(--muted);
    line-height: 1.6;
  }

  .listening__embed {
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
    border-radius: 12px;
  }

  .listening__fallback {
    margin: 0.8rem 0 0;
    color: var(--faint);
    font-size: 0.8rem;
  }

  .listening__fallback a {
    color: var(--muted);
    text-underline-offset: 0.2em;
  }
</style>
