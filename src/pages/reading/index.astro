---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PixelHeading from "../../components/PixelHeading.astro";
import LinkRow from "../../components/LinkRow.astro";
import Bookshelf from "../../components/Bookshelf.astro";

const shelf = (await getCollection("reading"))
  .filter((item) => item.data.kind === "Book")
  .sort((a, b) => a.data.order - b.data.order);

const blogs = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Reading"
  description="Books and blog posts Vee keeps close and keeps pointing people at."
>
  <header class="page-head column">
    <PixelHeading title="Reading" section="Reading" />
    <p>Occasionally I write and mediocrely I read books. Some of these are below:</p>
  </header>

  <section class="section column" aria-labelledby="shelf">
    <div class="section-head"><h2 id="shelf">Shelf</h2></div>
    <p class="shelf-copy">Books currently at my shelf</p>
    {shelf.length ? (
      <Bookshelf books={shelf} />
    ) : (
      <p class="section-note">This shelf is still being filled.</p>
    )}
  </section>

  <section class="section column" aria-labelledby="blogs">
    <div class="section-head"><h2 id="blogs">Blogs</h2></div>
    <p class="blogs-copy">A few longer notes from me:</p>
    {blogs.length ? (
      <ul class="rows">
        {blogs.map((post) => (
          <LinkRow
            title={post.data.title}
            note={post.data.summary}
            href={post.data.url}
          />
        ))}
      </ul>
    ) : (
      <p class="section-note">Notes are on the way.</p>
    )}
  </section>
</BaseLayout>

<style>
  .shelf-copy,
  .blogs-copy {
    max-width: 62ch;
    margin: -0.7rem 0 1.35rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
</style>
