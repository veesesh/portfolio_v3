---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="case-study shell">
    <a class="back-link" href="/work"><span aria-hidden="true">←</span> All work</a>
    <header class="case-study__header">
      <p class="eyebrow">{entry.data.kicker}</p>
      <h1>{entry.data.title}</h1>
      <p class="case-study__summary">{entry.data.summary}</p>
    </header>
    <div class="case-study__layout">
      <aside class="case-study__facts" aria-label="Project details">
        <dl>
          <div><dt>Role</dt><dd>{entry.data.role}</dd></div>
          <div><dt>Period</dt><dd>{entry.data.period}</dd></div>
          <div><dt>Across</dt><dd>{entry.data.tags.join(", ")}</dd></div>
        </dl>
        {entry.data.links.length > 0 && (
          <div class="case-study__links">
            {entry.data.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            ))}
          </div>
        )}
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
    <a class="next-cta" href="/work">
      <span>Keep exploring</span>
      <strong>See all work <span aria-hidden="true">↗</span></strong>
    </a>
  </article>
</BaseLayout>
