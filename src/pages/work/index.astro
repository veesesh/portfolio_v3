---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { earlierBuilds, programArchive } from "../../data/site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Selected systems, builder programs, community work, and earlier experiments by Vee."
>
  <header class="page-hero shell shell--reading">
    <p class="eyebrow">Work</p>
    <h1>Systems for communities.<br /><em>Communities around tools.</em></h1>
    <p>
      I work across community, operations, developer experience, and agentic systems. These are
      three stories that show how those disciplines connect.
    </p>
  </header>

  <section class="section shell" aria-labelledby="case-studies-title">
    <h2 id="case-studies-title" class="sr-only">Case studies</h2>
    <div class="work-grid work-grid--index">
      {work.map((entry, index) => <WorkCard entry={entry} index={index + 1} />)}
    </div>
  </section>

  <section class="section shell archive-section" aria-labelledby="program-archive-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Program archive</p>
        <h2 id="program-archive-title">Other rooms I helped build.</h2>
      </div>
    </div>
    <div class="archive-list">
      {programArchive.map((item) => (
        <article>
          <div>
            <p class="archive-list__meta">{item.descriptor}</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
          {item.href && <a href={item.href} target="_blank" rel="noreferrer" aria-label={`Open ${item.title} overview`}>↗<span class="sr-only"> Opens in a new tab</span></a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section shell archive-section" aria-labelledby="earlier-builds-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Earlier builds</p>
        <h2 id="earlier-builds-title">Experiments that taught me to ship.</h2>
      </div>
    </div>
    <div class="archive-list archive-list--compact">
      {earlierBuilds.map((item) => (
        <article>
          <div>
            <p class="archive-list__meta">{item.descriptor}</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
          {item.href && <a href={item.href} target="_blank" rel="noreferrer" aria-label={`Open ${item.title}`}>↗<span class="sr-only"> Opens in a new tab</span></a>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
