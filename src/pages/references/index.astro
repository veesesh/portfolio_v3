---
/** Credit where it is owed. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkRow from "../../components/LinkRow.astro";

const references = [
  { title: "Arlan's Vault", href: "https://www.arlan.me/vault" },
  { title: "recent.design", href: "https://recent.design/" },
];
---

<BaseLayout
  title="References"
  description="The sites Vee took references from while building this portfolio."
>
  <header class="page-head column">
    <h1>References</h1>
    <p>
      I took references from the sites below while building this portfolio.
    </p>
  </header>

  <section class="section column" aria-labelledby="references-list">
    <div class="section-head"><h2 id="references-list">Where things came from</h2></div>
    <ul class="rows">
      {references.map((item) => (
        <LinkRow title={item.title} href={item.href} />
      ))}
    </ul>
  </section>
</BaseLayout>
