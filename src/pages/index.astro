---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Portrait from "../components/Portrait.astro";
import NameReveal from "../components/NameReveal.astro";
import SectionHead from "../components/SectionHead.astro";
import LinkRow from "../components/LinkRow.astro";
import RainbowToggle from "../components/RainbowToggle.astro";
import { about, aboutPlain, photos, profileLinks, site, spotify } from "../data/site";
import { period } from "../lib/format";

const rolesById = new Map((await getCollection("roles")).map((role) => [role.id, role]));
const roles = ["devfolio", "codeday-hyderabad", "hackerabad", "kalakumbh"].flatMap(
  (id) => rolesById.get(id) ?? [],
);

const reading = (await getCollection("reading"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const strip = photos.slice(0, 4);
---

<BaseLayout title={site.name} description={aboutPlain}>
  <section class="hero column">
    <div class="hero__text">
      <h1 class="hero__name"><NameReveal variant="hero" /></h1>

      <p class="lede hero__intro">
        {about.before}<a href={about.link.href} data-sfx="nav" target="_blank" rel="noreferrer"
          >{about.link.label}<span class="sr-only"> (opens in a new tab)</span></a
        >{about.after}
      </p>

      <nav class="hero__links" aria-label="Elsewhere">
        {profileLinks.map((link) => (
          <a
            href={link.href}
            data-sfx="nav"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {link.label}
            {link.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </nav>
    </div>

    <div class="hero__figure">
      <Portrait alt={`${site.name}, drawn in coloured pencil`} />
    </div>
  </section>

  <div class="rainbow-break column">
    <RainbowToggle />
  </div>

  <section class="section column" aria-labelledby="home-work">
    <SectionHead id="home-work" label="Work experience" />
    <ul class="rows">
      {roles.map((role) => (
        <LinkRow
          title={role.data.organization}
          aside={period(role.data.start, role.data.end)}
          note={role.data.role}
          href={role.data.href}
        />
      ))}
    </ul>
  </section>

  <section class="section column" aria-labelledby="home-building">
    <SectionHead id="home-building" label="Build" href="/build" seeAll="see all" />
    <ul class="rows">
      {[
        {
          title: "Initiatives",
          aside: "Devfolio",
          note: "Builder programs and hackathon experiences I help take from an idea to a room full of people.",
          href: "/build#initiatives",
        },
        {
          title: "Systems",
          aside: "Devfolio",
          note: "Internal tools and agents that make the recurring parts of the work lighter.",
          href: "/build#systems",
        },
        {
          title: "Own projects",
          aside: "Side quests",
          note: "Things I make outside work, usually with friends, curiosity, and a short deadline.",
          href: "/build#own-projects",
        },
      ].map((project) => (
        <LinkRow
          title={project.title}
          aside={project.aside}
          note={project.note}
          href={project.href}
        />
      ))}
    </ul>
  </section>

  <section class:list={["section", "column", { "section--bare": reading.length === 0 }]} aria-labelledby="home-reading">
    <SectionHead id="home-reading" label="Reading" />
    {reading.length ? (
      <ul class="rows">
        {reading.map((item) => (
          <LinkRow
            title={item.data.title}
            aside={item.data.kind}
            note={`${item.data.author} — ${item.data.note}`}
            href={item.data.url}
          />
        ))}
      </ul>
    ) : (
      <p class="section-note">Shelf still being filled.</p>
    )}
  </section>

  <section class="section column" aria-labelledby="home-listening">
    <SectionHead id="home-listening" label="Listening" />
    <ul class="rows">
      <LinkRow
        title={spotify.title}
        aside="Spotify"
        note="A small, current corner of the internet for what has been in rotation lately."
        href="/listening"
      />
    </ul>
  </section>

  <section class="section column" aria-labelledby="home-pictures">
    <SectionHead id="home-pictures" label="Pictures" />
    <p class="pictures-note">I also photograph and make little videos here and there. I’ll share a few of them soon.</p>
    <a class="strip" href="/pictures" data-sfx="row" aria-label="Open the pictures page">
      {strip.map((photo, index) => (
        <img
          src={photo.src}
          alt=""
          width={photo.width}
          height={photo.height}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))}
    </a>
  </section>

  <section class="section column" aria-label="Other parts of my life">
    <a class="life-link" href="/life" data-sfx="row">Other parts of my life <span aria-hidden="true">→</span></a>
  </section>

</BaseLayout>

<style>
  /* Layout B: text on the spine of the page, portrait to the right. Shares the
     same column width as every section below, so the hero doesn't sit on a
     different axis to the rest of the page. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 4.5rem);
  }

  .hero__figure {
    width: 12.5rem;
  }

  .hero__name {
    margin: 0;
    line-height: 1;
  }

  .hero__intro {
    max-width: 40ch;
    margin: 1.3rem 0 0;
  }

  .hero__intro a {
    color: var(--accent);
    font-weight: 500;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 130ms ease;
  }

  .hero__intro a:hover {
    text-decoration-color: var(--accent);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1.6rem;
  }

  .hero__links a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: color 130ms ease, border-color 130ms ease;
  }

  .hero__links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
    text-decoration: none;
  }

  .rainbow-break {
    display: flex;
    justify-content: center;
    padding-block: 0.5rem;
  }

  .pictures-note {
    max-width: 54ch;
    margin: -0.7rem 0 1.35rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .life-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.65rem 0.95rem;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-decoration: none;
    transition: border-color 130ms ease, color 130ms ease;
  }

  .life-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .strip img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    filter: saturate(0.85);
    transition: filter 200ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .strip:hover img {
      filter: saturate(1);
    }
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero__figure {
      order: -1;
      width: 11rem;
    }
  }

  @media (max-width: 640px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
