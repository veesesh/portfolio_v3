---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Portrait from "../components/Portrait.astro";
import NameReveal from "../components/NameReveal.astro";
import SectionHead from "../components/SectionHead.astro";
import LinkRow from "../components/LinkRow.astro";
import Bookshelf from "../components/Bookshelf.astro";
import RainbowToggle from "../components/RainbowToggle.astro";
import LinkPreview from "../components/LinkPreview.astro";
import { about, aboutPlain, profileLinks, site, stripPhotos } from "../data/site";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { period } from "../lib/format";

const rolesById = new Map((await getCollection("roles")).map((role) => [role.id, role]));
const roles = ["devfolio", "codeday-hyderabad", "hackerabad", "kalakumbh"].flatMap(
  (id) => rolesById.get(id) ?? [],
);

/** The whole shelf, left to right, exactly as it stands on the reading page. */
const shelf = (await getCollection("reading"))
  .filter((item) => item.data.kind === "Book")
  .sort((a, b) => a.data.order - b.data.order);

const strip = stripPhotos;

/** Newest first, same order the blogs run in on /reading. */
const posts = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/**
 * A preview is only offered when its screenshot is actually on disk. Trusting
 * the data alone would hand a visitor an empty browser frame for any link whose
 * image had not been added yet, which looks broken rather than unfinished.
 */
const links = profileLinks.map((link) => ({
  ...link,
  preview:
    link.preview && existsSync(join(process.cwd(), "public", link.preview))
      ? link.preview
      : undefined,
}));
---

<BaseLayout title={site.name} description={aboutPlain}>
  <section class="hero column">
    <div class="hero__text">
      <h1 class="hero__name"><NameReveal variant="hero" /></h1>

      <p class="lede hero__intro">{about.greeting}</p>

      <p class="lede hero__intro">
        {about.lead.before}<span class="pop" tabindex="0" aria-describedby="jack-quote"
          >{about.lead.pop}<span class="pop__card" id="jack-quote" role="tooltip"
            >{about.quote.head} <mark>{about.quote.tail}</mark></span
          ></span
        >{about.lead.after}{" "}
        {about.now.before}<a href={about.now.link.href} data-sfx="nav" target="_blank" rel="noreferrer"
          >{about.now.link.label}<span class="sr-only"> (opens in a new tab)</span></a
        >{about.now.after}
      </p>

      <nav class="hero__links" aria-label="Elsewhere">
        {links.map((link) => (
          <a
            href={link.href}
            data-sfx="nav"
            data-preview={link.preview}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {link.label}
            {link.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </nav>

      {/*
        A step quieter than the row above it, and only the destination is a
        link — so it reads as an aside rather than a sixth social account.
      */}
      <p class="hero__hint">
        press <kbd>T</kbd> to say hi on{" "}
        <a href={site.telegram.href} data-sfx="nav" target="_blank" rel="noreferrer"
          >Telegram<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    </div>

    <div class="hero__figure">
      <Portrait alt={`${site.name}, drawn in coloured pencil`} />
    </div>
  </section>

  <div class="rainbow-break column">
    <RainbowToggle />
  </div>

  <section class="section column" aria-labelledby="home-work">
    <SectionHead id="home-work" label="Work experience" />
    <ul class="rows">
      {roles.map((role) => (
        <LinkRow
          title={role.data.organization}
          aside={period(role.data.start, role.data.end)}
          note={role.data.role}
          href={role.data.href}
        />
      ))}
    </ul>
  </section>

  <section class="section column" aria-labelledby="home-building">
    <SectionHead id="home-building" label="Build" href="/build" seeAll="see everything" />
    <p class="build-note">Things I&rsquo;ve worked on.</p>
    <ul class="rows">
      {[
        {
          title: "Hackathons & Initiatives",
          aside: "Devfolio",
          note: "I've helped run builder initiatives across India and beyond, including programs with Anthropic and AWS.",
          href: "/build#initiatives-and-hackathons",
        },
        {
          title: "Agentic Systems",
          aside: "Devfolio",
          note: "I get bored with doing the same thing twice, so I built agents and tools around it.",
          href: "/build#agentic-systems",
        },
        {
          title: "Personal Projects",
          aside: "Side quests",
          note: "Things I build outside work, usually out of curiosity, with friends, or just because I wanted to see if I could.",
          href: "/build#personal-projects",
        },
      ].map((project) => (
        <LinkRow
          title={project.title}
          aside={project.aside}
          note={project.note}
          href={project.href}
        />
      ))}
    </ul>
  </section>

  <section class:list={["section", "column", { "section--bare": shelf.length === 0 }]} aria-labelledby="home-reading">
    <SectionHead id="home-reading" label="Reading" href="/reading" seeAll="see the whole shelf" />
    {shelf.length ? (
      <>
        <p class="reading-note">These are the books currently sitting on my shelf at home. Poke around and pick one.</p>
        <Bookshelf books={shelf} eager={false} />
      </>
    ) : (
      <p class="section-note">Shelf still being filled.</p>
    )}
  </section>

  <section class="section column" aria-labelledby="home-writing">
    <SectionHead id="home-writing" label="Writing" href="/reading#blogs" seeAll="read the rest" />
    <p class="writing-note">Longer notes I&rsquo;ve written, mostly about the rooms I help put together.</p>
    <ul class="rows">
      {posts.map((post) => (
        <LinkRow
          title={post.data.title}
          aside={post.data.outlet}
          note={post.data.summary}
          href={post.data.url}
        />
      ))}
    </ul>
  </section>

  <section class="section column" aria-labelledby="home-pictures">
    <SectionHead id="home-pictures" label="Pictures" href="/pictures" seeAll="through my lens" />
    <p class="pictures-note">A few frames from the hackathons I&rsquo;ve been lucky to be around.</p>
    <a class="strip" href="/pictures" data-sfx="row" aria-label="Open the pictures page">
      {strip.map((photo, index) => (
        <img
          src={photo.src}
          alt=""
          width={photo.width}
          height={photo.height}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))}
    </a>
    <p class="strip-caption">Photo sets I&rsquo;ve shot and a few videos I&rsquo;ve cut together.</p>
  </section>

  <section class="section column" aria-label="Other parts of my life">
    <a class="life-link" href="/life" data-sfx="row">Other parts of my life <span aria-hidden="true">→</span></a>
  </section>

  <LinkPreview />
</BaseLayout>


<style>
  /* Layout B: text on the spine of the page, portrait to the right. Shares the
     same column width as every section below, so the hero doesn't sit on a
     different axis to the rest of the page. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 4.5rem);
  }

  .hero__figure {
    width: 12.5rem;
  }

  .hero__name {
    margin: 0;
    line-height: 1;
  }

  .hero__intro {
    max-width: 40ch;
    margin: 1.3rem 0 0;
    text-align: justify;
    /* Justifying a 40ch measure without hyphenation opens rivers of white space
       between words. Auto-hyphenation lets the browser break long words instead
       of stretching the spaces around them. */
    hyphens: auto;
  }


  .hero__intro a {
    color: var(--accent);
    font-weight: 500;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 130ms ease;
  }

  .hero__intro a:hover {
    text-decoration-color: var(--accent);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 1.6rem;
  }

  .hero__links a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: color 130ms ease, border-color 130ms ease;
  }

  .hero__links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /*
   * The phrase carries the colour and the quote hangs off it. Focusable as well
   * as hoverable, because a card that only a mouse can reach is a card half the
   * visitors never see.
   */
  .pop {
    position: relative;
    color: var(--pop);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: color-mix(in oklab, var(--pop) 45%, transparent);
    text-underline-offset: 0.22em;
    cursor: var(--cursor-hand);
  }

  .pop__card {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 40;
    width: max-content;
    max-width: min(23rem, 72vw);
    border: 1px solid var(--rule-strong);
    border-radius: 9px;
    background: var(--page);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 12px 30px rgb(0 0 0 / 0.09);
    padding: 0.7rem 0.85rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 400;
    line-height: 1.55;
    /* The card is its own sentence; the justification of the paragraph it sits
       inside would otherwise stretch it. */
    text-align: left;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(3px);
    transition: opacity 160ms var(--ease), transform 160ms var(--ease), visibility 160ms;
  }

  .pop:hover .pop__card,
  .pop:focus-visible .pop__card {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* The half that turns the insult into a compliment. */
  .pop__card mark {
    background: color-mix(in oklab, var(--pop) 16%, transparent);
    border-radius: 3px;
    padding: 0.05em 0.15em;
    color: var(--ink);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .pop__card {
      transition-duration: 1ms;
      transform: none;
    }
  }

  .hero__hint {
    margin: 0.55rem 0 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .hero__hint a {
    color: var(--muted);
    text-underline-offset: 0.2em;
  }

  .hero__hint a:hover {
    color: var(--accent);
  }

  .hero__hint kbd {
    display: inline-block;
    min-width: 1.4em;
    border: 1px solid var(--rule-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.02em 0.3em;
    background: var(--page);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.95em;
    line-height: 1.35;
    text-align: center;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4rem;
    text-decoration: none;
  }

  .rainbow-break {
    display: flex;
    justify-content: center;
    padding-block: 0.5rem;
  }

  /* Sits under the frames it describes, so it reads as their caption. */
  .strip-caption {
    max-width: 54ch;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .build-note,
  .reading-note,
  .writing-note,
  .pictures-note {
    max-width: 54ch;
    margin: -0.7rem 0 1.35rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .life-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.65rem 0.95rem;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-decoration: none;
    transition: border-color 130ms ease, color 130ms ease;
  }

  .life-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .strip img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    filter: saturate(0.85);
    transition: filter 200ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .strip:hover img {
      filter: saturate(1);
    }
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero__figure {
      order: -1;
      width: 11rem;
    }
  }

  @media (max-width: 640px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
