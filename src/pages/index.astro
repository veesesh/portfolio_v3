---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import { experience, photos, profileLinks } from "../data/site";

const featuredWork = (await getCollection("work"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const recentNotes = (await getCollection("notes"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const trove = (await getCollection("trove")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<BaseLayout
  title="Vee"
  description="Vee is a generalist working across community, operations, developer experience, and agentic systems at Devfolio."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero__main">
      <p class="eyebrow">Community × systems × builder experience</p>
      <h1 id="hero-title">
        I build systems and communities for <em>people who make things.</em>
      </h1>
      <p class="hero__intro">
        I’m Vee, a generalist working where community, developer experience, and operations meet.
        At Devfolio, I lead builder initiatives and turn repetitive work into useful agents and
        internal tools.
      </p>
      <div class="hero__links">
        {profileLinks.slice(0, 4).map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
            {link.label}
            {link.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </div>
    </div>

    <aside class="now-card" aria-label="Current focus">
      <div class="now-card__status"><span aria-hidden="true"></span> Now building</div>
      <p class="now-card__title">Push to Prod:<br />Building at the Frontier</p>
      <p>
        Leading the builder experience and operations behind a frontier-technology sprint in
        Bengaluru.
      </p>
      <a href="/work/push-to-prod">Follow the work <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="section shell" aria-labelledby="selected-work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="selected-work-title">Systems, rooms, and the work between.</h2>
      </div>
      <a class="text-link" href="/work">All work <span aria-hidden="true">↗</span></a>
    </div>
    <div class="work-grid">
      {featuredWork.map((entry, index) => <WorkCard entry={entry} index={index + 1} />)}
    </div>
  </section>

  <section class="section section--split shell" aria-labelledby="experience-title">
    <div class="section-heading section-heading--stacked">
      <p class="eyebrow">Experience</p>
      <h2 id="experience-title">Working across disciplines, not inside a box.</h2>
      <p>
        The thread through my work is simple: understand what people need, make the system around
        them work better, and stay close enough to learn from the result.
      </p>
    </div>
    <ol class="timeline">
      {experience.map((item) => (
        <li>
          <div class="timeline__period">{item.period}</div>
          <div>
            <h3>
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.organization}<span class="sr-only"> (opens in a new tab)</span></a> : item.organization}
            </h3>
            <p class="timeline__role">{item.role}</p>
            <p>{item.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section shell" aria-labelledby="notes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Notes from the work</p>
        <h2 id="notes-title">Things I am learning in public.</h2>
      </div>
      <a class="text-link" href="/notes">All notes <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-notes">
      {recentNotes.map((note) => (
        <article>
          <p class="home-notes__meta">
            <time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-IN", { month: "short", year: "numeric" })}</time>
            <span>{note.data.kind}</span>
          </p>
          <h3><a href={`/notes/${note.id}`}>{note.data.title}</a></h3>
          <p>{note.data.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="away-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Away from the keyboard</p>
        <h2 id="away-title">A trove of things I return to.</h2>
      </div>
      <a class="text-link" href="/trove">Open the trove <span aria-hidden="true">↗</span></a>
    </div>
    <div class="trove-preview">
      {trove.map((item) => (
        <article>
          <p>{item.data.category} · {item.data.status}</p>
          <h3>{item.data.title}</h3>
          <span aria-hidden="true">✦</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section gallery-preview shell" aria-labelledby="gallery-preview-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Community archive</p>
        <h2 id="gallery-preview-title">The people make the room.</h2>
      </div>
      <a class="text-link" href="/gallery">See the gallery <span aria-hidden="true">↗</span></a>
    </div>
    <a class="gallery-preview__images" href="/gallery" aria-label="Open the community photo gallery">
      {photos.slice(0, 3).map((photo, index) => (
        <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading={index === 0 ? "eager" : "lazy"} />
      ))}
    </a>
  </section>
</BaseLayout>
