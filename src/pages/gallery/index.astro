---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import { photos } from "../../data/site";
---

<BaseLayout title="Gallery" description="A visual archive of builder communities, events, and rooms Vee helped bring together.">
  <header class="page-hero shell shell--reading">
    <p class="eyebrow">Community archive</p>
    <h1>Rooms full of builders,<br /><em>and the people who mattered.</em></h1>
    <p>
      These are community moments rather than a personal photography portfolio. My own frames and
      video experiments will join the site as I curate them.
    </p>
  </header>
  <section class="section shell gallery-page" aria-label="Community photographs">
    <Gallery photos={photos} />
  </section>
</BaseLayout>
