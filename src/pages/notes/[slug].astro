---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("notes");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="note-page shell shell--reading">
    <a class="back-link" href="/notes"><span aria-hidden="true">←</span> All notes</a>
    <header class="note-page__header">
      <div class="note-page__meta">
        <time datetime={entry.data.date.toISOString()}>{date}</time>
        <span>{entry.data.kind}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>
    <div class="prose prose--note"><Content /></div>
    {entry.data.externalUrl && (
      <a class="external-cta" href={entry.data.externalUrl} target="_blank" rel="noreferrer">
        Read the public source <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
  </article>
</BaseLayout>
