---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteRow from "../../components/NoteRow.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Notes" description="Field notes from Vee's work across community, programs, and agentic systems.">
  <header class="page-hero shell shell--reading">
    <p class="eyebrow">Notes</p>
    <h1>Learning by doing,<br /><em>then writing it down.</em></h1>
    <p>
      Field notes from systems I am building, programs I am helping run, and questions I have not
      completely resolved yet.
    </p>
  </header>
  <section class="section shell notes-list" aria-label="All notes">
    {notes.map((entry) => <NoteRow entry={entry} />)}
  </section>
</BaseLayout>
