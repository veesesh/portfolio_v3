---
// TEMPORARY. "sesh" colour exploration — delete once one is chosen.
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist";
import "../styles/global.css";
import { site } from "../data/site";

const rest = site.fullName.slice(site.name.length);

const options = [
  { id: "grey", label: "0 — Grey (current)", hex: "#6b6b6b", contrast: "4.9:1" },
  { id: "blue-deep", label: "1 — Water blue, deep", hex: "#2f6aa6", contrast: "5.1:1" },
  { id: "blue-vivid", label: "2 — Water blue, vivid", hex: "#1f6fc4", contrast: "4.6:1" },
  { id: "teal", label: "3 — Railing teal", hex: "#217163", contrast: "5.3:1" },
  { id: "amber", label: "4 — Sunflower amber", hex: "#84500c", contrast: "6.1:1" },
  { id: "slate", label: "5 — Slate blue", hex: "#3d5878", contrast: "6.7:1" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Name colour options</title>
  </head>
  <body>
    <div class="ground" aria-hidden="true"></div>
    <div class="wrap">
      <h1>“sesh” colour</h1>
      <p class="note">
        All hues sampled from the portrait, darkened until they carry on the blue bloom that sits
        behind the name. Contrast measured against <code>#f0f5fa</code>.
      </p>
      {options.map((o) => (
        <div class="row">
          <p class="row__tag">{o.label} · {o.hex} · {o.contrast}</p>
          <p class="row__name">{site.name}<span style={`color:${o.hex}`}>{rest}</span></p>
        </div>
      ))}
    </div>

    <style>
      .wrap {
        width: min(100% - 3rem, 46rem);
        margin: 3rem auto 5rem;
      }
      h1 {
        margin: 0;
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
      }
      .note {
        max-width: 60ch;
        color: var(--muted);
        font-size: 0.9rem;
      }
      .note code {
        font-family: var(--mono);
        font-size: 0.85em;
      }
      .row {
        border-top: 1px solid var(--rule);
        padding-block: 1.4rem 1.2rem;
      }
      .row__tag {
        margin: 0 0 0.4rem;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .row__name {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(2.4rem, 8vw, 3.9rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
      }
    </style>
  </body>
</html>
