---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PixelHeading from "../../components/PixelHeading.astro";
import { Content } from "../../notes/build.md";
---

<BaseLayout
  title="Build"
  description="Builder initiatives, internal systems, and side projects Vee has helped bring to life."
>
  <header class="page-head column">
    <PixelHeading title="Build" section="Build" />
  </header>

  {/*
    The note supplies every heading below the h1, so nothing here restates it.
    `.note` is a global class rather than a scoped one: this markup is rendered
    from markdown at runtime and never passes through Astro's scoping.
  */}
  <div class="section column note">
    <Content />
  </div>
</BaseLayout>
