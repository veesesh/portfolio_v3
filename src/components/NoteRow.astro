---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const date = entry.data.date.toLocaleDateString("en-IN", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<article class="note-row">
  <a href={`/notes/${entry.id}`}>
    <div class="note-row__meta">
      <time datetime={entry.data.date.toISOString()}>{date}</time>
      <span>{entry.data.kind}</span>
    </div>
    <div>
      <h2>{entry.data.title}</h2>
      <p>{entry.data.summary}</p>
    </div>
    <span class="note-row__arrow" aria-hidden="true">↗</span>
  </a>
</article>
