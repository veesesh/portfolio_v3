---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index?: number;
}

const { entry, index } = Astro.props;
---

<article class="work-card">
  <a class="work-card__link" href={`/work/${entry.id}`} aria-label={`Read case study: ${entry.data.title}`}>
    <div class="work-card__topline">
      <span>{index ? String(index).padStart(2, "0") : entry.data.kicker}</span>
      <span aria-hidden="true">↗</span>
    </div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
    <ul class="tag-row" aria-label={`${entry.data.title} themes`}>
      {entry.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
    </ul>
  </a>
</article>
